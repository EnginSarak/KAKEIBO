{
  "installCommand": "cd frontend && yarn install",
  "buildCommand": "cd frontend && REACT_APP_LEGAL_UPDATED=\"$(git log -1 --format=%cs -- src/pages/LegalPages.js 2>/dev/null || true)\" yarn build",
  "outputDirectory": "frontend/build",
  "build": {
    "env": {
      "CI": "false"
    }
  },
  "headers": [
    {
      "source": "/imprint",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    },
    {
      "source": "/privacy",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive, nosnippet"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://kakeibo-application1.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
